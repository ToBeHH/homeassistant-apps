#!/usr/bin/env bashio
# shellcheck shell=bash
# ==============================================================================
# The import is not essential: log and let s6 restart it, keep the app up.
# ==============================================================================

declare APP_EXIT_CODE=${1}

if [[ "${APP_EXIT_CODE}" -ne 0 ]] && [[ "${APP_EXIT_CODE}" -ne 256 ]]; then
  bashio::log.warning "Channel import stopped with exit code ${APP_EXIT_CODE}, restarting"
fi
