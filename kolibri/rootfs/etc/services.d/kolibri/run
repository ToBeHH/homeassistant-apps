#!/usr/bin/with-contenv bashio
# shellcheck shell=bash disable=SC2154
# ==============================================================================
# Kolibri – learning platform
# ==============================================================================

declare marker=/data/kolibri/.provisioned
declare output

# shellcheck source=/dev/null
source /usr/local/share/kolibri_app/kolibri-env.sh

bashio::log.info "Kolibri app $(bashio::app.version) starting"

if bashio::var.is_empty "${data_path}"; then
    bashio::log.warning "No data_path configured. Nothing will be downloaded until a storage location is set."
elif [[ ! -d "${data_path}" ]]; then
    bashio::log.warning "data_path '${data_path}' does not exist. Nothing will be downloaded."
elif [[ ! -w "${data_path}" ]]; then
    bashio::log.warning "data_path '${data_path}' is not writable. Nothing will be downloaded."
else
    bashio::log.info "Storage location: ${data_path}"
fi

# First setup only. Without a password Kolibri shows its setup wizard instead.
if [[ -f "${marker}" ]]; then
    bashio::log.info "Kolibri is set up; facility, admin and language options are not used anymore"
elif ! bashio::config.has_value 'admin_password'; then
    bashio::log.info "No admin_password set: Kolibri shows its setup wizard"
else
    bashio::log.info "Setting up Kolibri as $(bashio::config 'admin_username'), language $(bashio::config 'language')"
    if output=$(kolibri manage provisiondevice \
        --facility "$(bashio::config 'facility_name')" \
        --superusername "$(bashio::config 'admin_username')" \
        --superuserpassword "$(bashio::config 'admin_password')" \
        --preset nonformal \
        --language_id "$(bashio::config 'language')" \
        --noinput 2>&1); then
        bashio::log.info "Setup finished"
        touch "${marker}"
    elif [[ "${output}" == *DeviceAlreadyProvisioned* ]]; then
        bashio::log.warning "Kolibri was already set up in its wizard; facility, admin and language options are not used"
        touch "${marker}"
    else
        bashio::log.warning "Setup failed, Kolibri shows its setup wizard:"
        bashio::log.warning "$(tail -n 3 <<< "${output}")"
    fi
fi

exec kolibri start --foreground --port 18080 --zip-port "${zip_internal_port}"
