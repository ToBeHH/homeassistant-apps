#!/usr/bin/env bash
# ==============================================================================
# Writes the Alloy configuration from the app options (/data/options.json) to
# the file given as $1. Secrets stay out of it: the bearer token is read from
# the environment (ALLOY_TOKEN), SNMP communities go into the same tmpfs file
# only. Exits 3 when remote_write_url or token is missing.
# ==============================================================================
set -euo pipefail

out=$1
options=${OPTIONS_FILE:-/data/options.json}
journal_dir=${JOURNAL_DIR:-/var/log/journal}

opt() {
    jq -r --arg k "$1" '.[$k] // empty' "${options}"
}

# Alloy string literals use the same escaping as JSON strings.
str() {
    jq -n --arg v "$1" '$v'
}

remote_write_url=$(opt remote_write_url)
loki_url=$(opt loki_url)
if [[ -z "${remote_write_url}" || -z "$(opt token)" ]]; then
    exit 3
fi

labels="{ site = $(str "$(opt site)"), collector = $(str "$(opt collector)") }"

{
    cat <<EOF
// Generated by the app from its options at every start - do not edit.

prometheus.remote_write "monitoring" {
  endpoint {
    url          = $(str "${remote_write_url}")
    bearer_token = sys.env("ALLOY_TOKEN")
  }
  external_labels = ${labels}
}

// Alloy itself: always yields an "up" series, even if nothing else is scraped.
prometheus.exporter.self "alloy" { }

prometheus.scrape "alloy" {
  targets         = prometheus.exporter.self.alloy.targets
  forward_to      = [prometheus.remote_write.monitoring.receiver]
  scrape_interval = "60s"
}
EOF

    if [[ "$(opt home_assistant_metrics)" != "false" ]]; then
        cat <<'EOF'

// Home Assistant's prometheus integration, through the Supervisor proxy.
prometheus.scrape "homeassistant" {
  targets         = [{ __address__ = "supervisor:80", instance = "homeassistant" }]
  metrics_path    = "/core/api/prometheus"
  bearer_token    = sys.env("SUPERVISOR_TOKEN")
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.monitoring.receiver]
}
EOF
    fi

    if [[ -n "$(opt fritzbox_host)" ]]; then
        cat <<EOF

// FRITZ!Box via TR-064 (fritz-exporter, started by the app on 127.0.0.1:9787).
prometheus.scrape "fritzbox" {
  targets         = [{ __address__ = "127.0.0.1:9787", instance = $(str "$(opt fritzbox_host)") }]
  scrape_interval = "60s"
  scrape_timeout  = "30s"
  forward_to      = [prometheus.remote_write.monitoring.receiver]
}
EOF
    fi

    count=$(jq '.snmp_targets // [] | length' "${options}")
    if [[ "${count}" -gt 0 ]]; then
        # Own auth profile per target with a community other than "public".
        auths=$(jq -r '[.snmp_targets[] | select((.community // "public") != "public")
            | {key: ("community_" + .name), value: {community: .community, version: 2}}]
            | if length > 0 then {auths: from_entries} | tojson else "" end' "${options}")
        echo
        echo 'prometheus.exporter.snmp "snmp" {'
        if [[ -n "${auths}" ]]; then
            echo '  config_merge_strategy = "merge"'
            echo "  config                = $(str "${auths}")"
        fi
        for ((i = 0; i < count; i++)); do
            target=$(jq -c ".snmp_targets[${i}]" "${options}")
            name=$(jq -r '.name' <<< "${target}")
            community=$(jq -r '.community // "public"' <<< "${target}")
            auth=public_v2
            [[ "${community}" != "public" ]] && auth="community_${name}"
            cat <<EOF

  target $(str "${name}") {
    address = $(str "$(jq -r '.address' <<< "${target}")")
    module  = $(str "$(jq -r '.modules // "if_mib,hrStorage"' <<< "${target}")")
    auth    = $(str "${auth}")
  }
EOF
        done
        cat <<'EOF'
}

prometheus.scrape "snmp" {
  targets         = prometheus.exporter.snmp.snmp.targets
  scrape_interval = "120s"
  scrape_timeout  = "60s"
  forward_to      = [prometheus.remote_write.monitoring.receiver]
}
EOF
    fi

    if [[ -n "${loki_url}" ]]; then
        cat <<EOF

loki.write "monitoring" {
  endpoint {
    url          = $(str "${loki_url}")
    bearer_token = sys.env("ALLOY_TOKEN")
  }
  external_labels = ${labels}
}
EOF
        # Without journald access (or outside Home Assistant) the source would fail to start.
        if [[ "$(opt journal_logs)" != "false" && -d "${journal_dir}" ]]; then
            cat <<EOF

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal_container_name"]
    target_label  = "container"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

loki.source.journal "journal" {
  path          = $(str "${journal_dir}")
  max_age       = "12h"
  labels        = { job = "journal" }
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.write.monitoring.receiver]
}
EOF
        fi
    fi
} > "${out}.tmp"

mv "${out}.tmp" "${out}"
