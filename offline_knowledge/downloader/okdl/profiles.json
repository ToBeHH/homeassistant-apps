{
  "_comment": [
    "Content profiles: profile -> language -> Kiwix ZIM names without date.",
    "'*' is the template for languages without their own list; {lang} is replaced",
    "by the language code. Names missing from the Kiwix catalog are skipped with a",
    "warning. Sizes per language as of 2026-10: slim de 20 GB / en 25 GB,",
    "standard de 58 GB / en 72 GB, full de 73 GB / en 150 GB."
  ],
  "slim": {
    "de": [
      "wikipedia_de_all_nopic",
      "wiktionary_de_all_nopic",
      "wikivoyage_de_all_nopic"
    ],
