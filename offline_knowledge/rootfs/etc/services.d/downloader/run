#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Offline Knowledge – content downloader
# ==============================================================================

bashio::log.info "Downloader starting"
export PYTHONPATH=/opt/okdl
export PYTHONUNBUFFERED=1
exec python3 -m okdl --options /data/options.json --state-dir /data/downloader \
    --wait-for http://127.0.0.1:8899/health
