#!/usr/bin/env bashio
# shellcheck shell=bash
# ==============================================================================
# The downloader is not essential: log and let s6 restart it, keep the app up.
# The run script waits 60 s before starting again.
# ==============================================================================

declare APP_EXIT_CODE=${1}

if [[ "${APP_EXIT_CODE}" -ne 0 ]] && [[ "${APP_EXIT_CODE}" -ne 256 ]]; then
  bashio::log.warning "Downloader stopped with exit code ${APP_EXIT_CODE}, restarting"
fi
