#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Offline Knowledge – MCP server (Streamable HTTP, bearer token required)
# ==============================================================================

# No port, no server: nobody could reach it, and it needs about 100 MB of RAM.
declare mcp_port
mcp_port=$(bashio::app.port "8900/tcp")
if ! bashio::var.has_value "${mcp_port}" || [[ "${mcp_port}" == "null" ]]; then
    bashio::log.info "MCP server off: no host port set for 8900/tcp"
    exec sleep 2147483647
fi

# shellcheck source=/dev/null
source /usr/local/share/offline_knowledge/zimi-env.sh

bashio::log.info "Starting MCP server on port 8900, tools: $(bashio::config 'mcp_tools' 'full')"
cd "${ZIMI_DATA_DIR}" || bashio::exit.nok "Cannot enter ${ZIMI_DATA_DIR}"
export PYTHONPATH=/opt/okdl
export PYTHONUNBUFFERED=1
exec python3 -m okmcp --options /data/options.json --port 8900
